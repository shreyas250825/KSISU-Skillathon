# ── Karnataka Skill Signal — Environment Variables ──────────────────────────
# Copy this file to .env and fill in values.
# Never commit .env to version control.

# Path to the directory containing the CSV data files.
# Default: two levels above /backend (the workspace root where the CSVs live).
# DATA_DIR=/path/to/your/data/directory

# Comma-separated list of allowed CORS origins for the API.
# Default: open (prototype only — restrict in production).
# CORS_ORIGINS=https://your-frontend.vercel.app,https://your-domain.com

# Port for the Uvicorn server (default: 8000)
# PORT=8000

# Set to "production" in deployed environments
# ENVIRONMENT=development
